diff --git a/src/dvbridge_placebo.c b/src/dvbridge_placebo.c
index eccd9f0..0e68bb0 100644
--- a/src/dvbridge_placebo.c
+++ b/src/dvbridge_placebo.c
@@ -64,6 +64,34 @@ bool dvbridge_hdr10_session_init(struct dvbridge_hdr10_session *out,
     return true;
 }
 
+bool dvbridge_hdr10_raw_session_init(struct dvbridge_hdr10_session *out,
+                                     const void *metadata, size_t bytes)
+{
+    struct dvbridge_hdr10_session candidate = {0};
+    if (!out || !dvbridge_hdr10_session_init(&candidate, metadata, bytes))
+        return false;
+    const AVDOVIColorMetadata *color = av_dovi_get_color(metadata);
+    const AVDOVIDmData *l6 = av_dovi_find_level(metadata, 6);
+    float black = color->source_min_pq <= 4095 ?
+        pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, color->source_min_pq / 4095.0f) : 0;
+    if (candidate.output.level6) {
+        black = l6->l6.min_luminance / 10000.0f;
+        /* Unmapped output keeps the source light levels, so they stay valid. */
+        if (l6->l6.max_cll <= 10000 && l6->l6.max_fall <= l6->l6.max_cll) {
+            candidate.output.max_cll = l6->l6.max_cll;
+            candidate.output.max_fall = l6->l6.max_fall;
+        }
+    }
+    if (!isfinite(black) || black < 0 || black >= candidate.target.hdr.max_luma)
+        black = 0;
+    candidate.target.hdr.min_luma = black > PL_COLOR_HDR_BLACK ? black : PL_COLOR_HDR_BLACK;
+    candidate.target.hdr.prim = *pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    candidate.output.min_luminance = (unsigned)lroundf(black * 10000.0f);
+    candidate.raw = true;
+    *out = candidate;
+    return true;
+}
+
 bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
                        size_t bytes, bool enhancement_layer_paired)
 {
diff --git a/src/dvbridge_placebo.h b/src/dvbridge_placebo.h
index 8d4797e..405b6db 100644
--- a/src/dvbridge_placebo.h
+++ b/src/dvbridge_placebo.h
@@ -35,11 +35,19 @@ struct dvbridge_hdr10_metadata {
 struct dvbridge_hdr10_session {
     struct pl_color_space target;
     struct dvbridge_hdr10_metadata output;
+    /* Raw composition: target is the reconstructed source itself, so the
+     * renderer performs no tone or gamut mapping. Output carries L6 as-is. */
+    bool raw;
 };
 /* Construct a stream target and signal together; failure leaves out unchanged.
  * Required enhancement-layer pairing is checked when the picture is rendered. */
 bool dvbridge_hdr10_session_init(struct dvbridge_hdr10_session *out,
                                  const void *metadata, size_t bytes);
+#define DVBRIDGE_HDR10_RAW_API 1
+/* As dvbridge_hdr10_session_init, but for the unmapped BL+EL composition.
+ * MaxCLL/MaxFALL and mastering black come from L6 when it is present. */
+bool dvbridge_hdr10_raw_session_init(struct dvbridge_hdr10_session *out,
+                                     const void *metadata, size_t bytes);
 bool dvbridge_get_hdr10_metadata(struct dvbridge_hdr10_metadata *out,
                                 const void *metadata, size_t bytes);
 /* Build a static PQ target in nits; dynamic L1 remains on the source only. */
diff --git a/src/dvbridge_policy.h b/src/dvbridge_policy.h
index 4d72633..bf518f9 100644
--- a/src/dvbridge_policy.h
+++ b/src/dvbridge_policy.h
@@ -52,7 +52,11 @@ struct dvbridge_policy {
     uint64_t lldv_edid_generation;
     unsigned lldv_edid_version;
     double lldv_primaries[6];
+    /* HDR10 Basic only: compose BL+EL and output it without tone or gamut
+     * mapping (dvbridge_hdr10_raw_session_init). Other modes ignore it. */
+    bool hdr10_raw;
 };
+#define DVBRIDGE_HDR10_RAW_POLICY_API 1
 struct dvbridge_identity { uint64_t stream, picture, revision; };
 enum dvbridge_policy_status {
     DVBRIDGE_POLICY_VALID, DVBRIDGE_POLICY_INVALID_VALUE, DVBRIDGE_POLICY_TV_PROFILE_REQUIRED
diff --git a/src/dvbridge_render.c b/src/dvbridge_render.c
index 143e34f..8492660 100644
--- a/src/dvbridge_render.c
+++ b/src/dvbridge_render.c
@@ -1233,7 +1233,26 @@ static bool render_picture(struct dvbridge_renderer *r, const struct pl_frame *s
         paired && mapped.dovi.nlq_active)
         processing &= ~CB1_PROCESSING_COLOUR;
     struct pl_color_map_params color_map = pl_color_map_default_params;
-    if (session) {
+    if (session && session->raw) {
+        /* Composition only: output the reconstructed BL+EL signal unchanged.
+         * Identical source and target spaces make libplacebo skip color
+         * mapping; clip mappers keep any residual step an identity. */
+        params.cb1_nearest_identity = true;
+        params.cb1_stable_pq = true;
+        params.sigmoid_params = NULL;
+        target.color = image.color;
+        target.color.primaries = PL_COLOR_PRIM_BT_2020;
+        target.color.transfer = PL_COLOR_TRC_PQ;
+        color_map = pl_color_map_default_params;
+        color_map.gamut_mapping = &pl_gamut_map_clip;
+        color_map.tone_mapping_function = &pl_tone_map_clip;
+        color_map.metadata = PL_HDR_METADATA_NONE;
+        color_map.inverse_tone_mapping = false;
+        color_map.gamut_expansion = false;
+        color_map.visualize_lut = false;
+        color_map.show_clipping = false;
+        params.color_map_params = &color_map;
+    } else if (session) {
         params.cb1_nearest_identity = true;
         target.color = session->target;
         /* Pin the accepted Basic policy independently of upstream defaults. */
@@ -1644,7 +1663,8 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     }
     struct active_mask mask={.rect={margins[0],margins[2],target_width-margins[1],target_height-margins[3]}};
     if(policy)memcpy(mask.rect,area,sizeof(area));
-    mask.maximum_pq=policy?cb1_hdr10_expert_ceiling(policy):dv_ideal_pq(session->target.hdr.max_luma);
+    mask.maximum_pq=policy?cb1_hdr10_expert_ceiling(policy):
+        session->raw?1.0f:dv_ideal_pq(session->target.hdr.max_luma);
     if(direct && direct->flip){float top=mask.rect[1];mask.rect[1]=target_height-mask.rect[3];mask.rect[3]=target_height-top;}
     const struct pl_hook blank={.stages=PL_HOOK_OUTPUT,.input=PL_HOOK_SIG_COLOR,
         .priv=&mask,.hook=mask_active_area,.signature=0x4342314853430001ULL};
